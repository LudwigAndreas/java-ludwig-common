<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        The parent is only a build-time convenience: it supplies the reactor's shared properties and
        the flatten-maven-plugin execution configured below. It is NOT part of what gets published -
        flatten runs in `bom` mode here, so the POM installed and deployed under these coordinates
        has no <parent> element at all and every version in it is a literal.

        That matters because a consumer importing this BOM must not be forced to resolve
        ru.ludwigandreas:common from a repository it may not have. Verified by resolving the BOM
        from a scratch project outside this reactor - see README, "Consuming the platform".
    -->
    <parent>
        <groupId>ru.ludwigandreas</groupId>
        <artifactId>common</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ludwig-bom</artifactId>
    <packaging>pom</packaging>

    <name>Ludwig platform BOM</name>
    <description>
        Dependency management for the Ludwig platform: every ru.ludwigandreas module at a single
        version, plus every third-party version the platform pins on top of what Spring Boot manages.
        Import this (scope=import, type=pom) to build a service against the platform without naming a
        single version; it is also imported by ludwig-service-parent, so a service inheriting that
        parent gets this BOM automatically and need not import it a second time.
    </description>

    <!--
        Deliberately no <build>, no <plugins> and no <modules>: this artifact is a version registry
        and nothing else. The flatten execution that rewrites it into a parentless, fully-literal POM
        is inherited from the reactor root; the property below is all it takes to switch that
        inherited execution from the root's `resolveCiFriendliesOnly` mode into `bom` mode.
    -->
    <properties>
        <flatten.mode>bom</flatten.mode>

        <!--
            THIRD-PARTY VERSIONS. This block is the single source of truth for every dependency
            version in the platform that Spring Boot does not manage, or that the platform manages
            differently from Spring Boot. It used to live in the reactor root's <properties>, where
            services could not reach it; it lives here so that importing one artifact carries it.

            Overriding one of these in a service: redeclare the property in the service's own
            <properties> AND redeclare the dependency with an explicit version - a property set in a
            consumer does not reach into an imported BOM's already-interpolated entries. See README.
        -->

        <!-- 1.18.34 fails on current JDK 17 patch releases with
             "ExceptionInInitializerError: com.sun.tools.javac.code.TypeTag :: UNKNOWN" - Lombok reaches
             into javac internals and needs a build that knows the compiler it is running under.
             This is deliberately ahead of the version Spring Boot manages; do not "align" it back. -->
        <lombok.version>1.18.38</lombok.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <querydsl.version>5.1.0</querydsl.version>
        <!-- Matches the QueryDSL APT processor's expectation; also the version Boot manages, pinned
             here because it is named explicitly in annotationProcessorPaths. -->
        <jakarta-persistence.version>3.1.0</jakarta-persistence.version>
        <olingo.version>4.10.0</olingo.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <archunit.version>1.5.0</archunit.version>
        <spring-kafka.version>3.2.4</spring-kafka.version>
        <spring-vault.version>3.1.2</spring-vault.version>
        <freemarker.version>2.3.32</freemarker.version>
        <springdoc.version>2.6.0</springdoc.version>
        <greenmail.version>2.1.3</greenmail.version>
        <jakarta-el.version>4.0.2</jakarta-el.version>
        <!-- Highest of the versions the transitive graph asks for; see the entry below. -->
        <checker-qual.version>3.42.0</checker-qual.version>
        <!-- Must track the opentelemetry.version that spring-boot-dependencies manages (1.37.0). -->
        <opentelemetry-alpha.version>1.37.0-alpha</opentelemetry-alpha.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                ORDERING IS LOAD-BEARING in this section. Maven resolves a managed version by taking
                the FIRST matching entry in the effective dependencyManagement, and an imported BOM is
                expanded in place, at the position of its <dependency> element. The explicit entries
                below therefore come first and win; the imports at the bottom fill in everything else.

                This is why the platform's overrides (Lombok, Testcontainers, FreeMarker) do not need
                the property-override trick that only works when you inherit spring-boot-starter-parent -
                this BOM does not inherit it, so the overrides are stated as entries instead.
            -->

            <!-- ==== This platform's own modules ==== -->
            <!-- ${project.version} resolves to a literal in the flattened POM that actually ships, so
                 a consumer never sees an unresolved expression here. -->
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>common-utils</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>db-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>web-core-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>odata-filter-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>job-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>outbox-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>reconciliation-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>security-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>identity-projection-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>hot-reload-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>observability-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>user-settings-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>rest-client-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>jira-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>architecture-rules</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>checkstyle-rules</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ==== Compile-time code generation ==== -->
            <!--
                These four are also named in ludwig-service-parent's annotationProcessorPaths. The
                compiler plugin is configured there with annotationProcessorPathsUseDepMgmt=true, so
                the processor paths take their versions from right here and the version of, say,
                Lombok cannot drift between the dependency and the processor that generates its code.
            -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <version>${lombok-mapstruct-binding.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- ==== QueryDSL ==== -->
            <!--
                A managed entry is keyed on groupId:artifactId:type:classifier, so the jakarta-classified
                artifacts need their own entries - a plain querydsl-jpa entry would not manage
                querydsl-jpa:jakarta and the version would have to be repeated at every use site.
            -->
            <dependency>
                <groupId>com.querydsl</groupId>
                <artifactId>querydsl-core</artifactId>
                <version>${querydsl.version}</version>
            </dependency>
            <dependency>
                <groupId>com.querydsl</groupId>
                <artifactId>querydsl-jpa</artifactId>
                <classifier>jakarta</classifier>
                <version>${querydsl.version}</version>
            </dependency>
            <dependency>
                <groupId>com.querydsl</groupId>
                <artifactId>querydsl-apt</artifactId>
                <classifier>jakarta</classifier>
                <version>${querydsl.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.persistence</groupId>
                <artifactId>jakarta.persistence-api</artifactId>
                <version>${jakarta-persistence.version}</version>
            </dependency>

            <!-- ==== OData ==== -->
            <dependency>
                <groupId>org.apache.olingo</groupId>
                <artifactId>odata-server-api</artifactId>
                <version>${olingo.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.olingo</groupId>
                <artifactId>odata-server-core</artifactId>
                <version>${olingo.version}</version>
            </dependency>

            <!-- ==== Resilience, config, docs ==== -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-core</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <!--
                The individual Resilience4j modules, rather than resilience4j-spring-boot3.
                rest-client-spring-boot-starter builds its policies per named client from
                ludwig.rest-client.*, so it wants the library and not that starter's parallel
                @ConfigurationProperties tree and AOP aspects. Listed one by one because a service
                that needs only a retry should not drag in a circuit-breaker state machine.
            -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-retry</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-circuitbreaker</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bulkhead</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-ratelimiter</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-timelimiter</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <!-- Binds the registries above to a MeterRegistry, which is how the per-client
                 retry/breaker/bulkhead metrics reach the platform's existing pipeline. -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-micrometer</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.vault</groupId>
                <artifactId>spring-vault-core</artifactId>
                <version>${spring-vault.version}</version>
            </dependency>
            <!-- Ahead of the version Spring Boot manages; the hot-reload starter's template source
                 depends on behaviour from this line. -->
            <dependency>
                <groupId>org.freemarker</groupId>
                <artifactId>freemarker</artifactId>
                <version>${freemarker.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- Spring Boot manages spring-kafka too; pinned here so the platform's Kafka line is
                 visible in one place and can be moved without moving the whole Boot line. -->
            <dependency>
                <groupId>org.springframework.kafka</groupId>
                <artifactId>spring-kafka</artifactId>
                <version>${spring-kafka.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.kafka</groupId>
                <artifactId>spring-kafka-test</artifactId>
                <version>${spring-kafka.version}</version>
            </dependency>

            <!-- ==== Convergence pins ==== -->
            <!--
                Not used directly by anything here. It is pinned because two independent transitive
                paths disagree about it - postgresql brings 3.42.0, Caffeine brings 3.37.0 - and the
                enforcer's dependencyConvergence rule in ludwig-service-parent fails a service build
                on exactly that. Maven's "nearest wins" would have picked one silently; pinning it
                makes the choice explicit and identical in every service.

                This is the intended way to answer a convergence failure: add an entry here, not a
                <exclusion> in one service or an exception to the rule.
            -->
            <dependency>
                <groupId>org.checkerframework</groupId>
                <artifactId>checker-qual</artifactId>
                <version>${checker-qual.version}</version>
            </dependency>

            <!--
                Same story, and a more consequential one. micrometer-tracing-bridge-otel drags in
                opentelemetry-api-incubator 1.38.0-alpha, while opentelemetry-exporter-otlp and the
                OTel SDK come from the Boot line at 1.37.0 and ask for 1.37.0-alpha. Running an
                incubator API a minor version ahead of the SDK it is incubating for is how you get a
                NoSuchMethodError inside the exporter at startup, on a code path no test touches.

                Pinned to the alpha that matches the SDK Boot manages, NOT to the newer one: the
                incubator artifact has to follow the SDK, not lead it. Move this together with the
                Boot line.
            -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-api-incubator</artifactId>
                <version>${opentelemetry-alpha.version}</version>
            </dependency>

            <!-- ==== Test-only ==== -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>com.icegreen</groupId>
                <artifactId>greenmail-junit5</artifactId>
                <version>${greenmail.version}</version>
            </dependency>
            <!-- Hibernate Validator's default message interpolator needs an EL implementation. -->
            <dependency>
                <groupId>org.glassfish</groupId>
                <artifactId>jakarta.el</artifactId>
                <version>${jakarta-el.version}</version>
            </dependency>

            <!--
                JUnit is deliberately absent from this BOM: the whole jupiter + platform stack comes
                from spring-boot-dependencies below, which keeps it internally consistent. Pinning
                junit-jupiter independently while junit-platform-launcher stayed BOM-managed once
                mixed Jupiter 5.12.2 with Platform 1.10.5 and broke test discovery with a
                NoSuchMethodError - see common-utils/pom.xml. Do not add JUnit entries here.
            -->

            <!-- ==== Imports, last: see the ordering note at the top of this section ==== -->
            <!--
                Ahead of the Testcontainers line spring-boot-dependencies carries. Imported as a BOM
                rather than pinned artifact by artifact so that every Testcontainers module - the ones
                used today and the ones a service adds later - stays on one version.
            -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                Everything else - Jackson, Micrometer, Hibernate, SnakeYAML, JUnit, Caffeine, Liquibase,
                the Spring projects - is whatever this Boot line says it is. ${spring-boot.version} is
                defined in the reactor root and is the platform's Boot baseline; ludwig-service-parent
                carries the same number in its <parent>, and the two must be moved together.
            -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
