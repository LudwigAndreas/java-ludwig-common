<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      Includes only. Every changeset is formatted SQL in its own NNNN-<slug>.sql file beside this
      one - see the database-migration capability. This file stays XML because Liquibase's
      formatted-SQL parser has no include directive; it is wiring, not a migration.

      Schema for file-ingest. Changeset ids and author are namespaced ("file-ingest-NNNN",
      "ludwig-file-ingest") so they never collide with a consuming application's own changesets in
      the shared DATABASECHANGELOG table - see FileIngestLiquibaseAutoConfiguration, which registers
      this changelog as an independent SpringLiquibase bean, and ludwig.ingest.liquibase.enabled,
      which switches that off for a service that would rather fold this into its own master history.

      Postgres-only, like every other changelog in this repository. The per-task staging tables are
      NOT here: they belong to the author's own schema, because only the author knows what a record
      looks like, and a module that created them would be guessing at columns.
    -->
    <include file="classpath:db/changelog/file-ingest/0001-create-run.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/file-ingest/0002-index-run-task-status.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/file-ingest/0003-create-quarantine.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/file-ingest/0004-rename-completed-to-succeeded.sql" relativeToChangelogFile="false"/>

</databaseChangeLog>
