<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      Includes only. Every changeset is formatted SQL in its own NNNN-<slug>.sql file beside this
      one - see the database-migration capability. This file stays XML because Liquibase's
      formatted-SQL parser has no include directive; it is wiring, not a migration.

      Schema for idempotency-spring-boot-starter. Changeset ids and author are namespaced
      ("idempotency-NNNN", "ludwig-idempotency") so they never collide with a consuming
      application's own changesets in the shared DATABASECHANGELOG table - see
      IdempotencyLiquibaseAutoConfiguration, which registers this changelog as an independent
      SpringLiquibase bean. Postgres-only, because the claim is a Postgres conditional upsert and
      this module says so rather than pretending to be portable.
    -->
    <include file="classpath:db/changelog/idempotency/0001-create-claim.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/idempotency/0002-migrate-notification-idempotency.sql" relativeToChangelogFile="false"/>

</databaseChangeLog>
