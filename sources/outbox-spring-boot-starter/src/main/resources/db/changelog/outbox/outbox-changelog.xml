<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      Includes only. Every changeset is formatted SQL in its own NNNN-<slug>.sql file beside this
      one - see the database-migration capability. This file stays XML because Liquibase's
      formatted-SQL parser has no include directive; it is wiring, not a migration.

      Schema for outbox-spring-boot-starter. Changeset ids and author are namespaced
      ("outbox-NNNN", "ludwig-outbox") so they never collide with a consuming application's own
      changesets in the shared DATABASECHANGELOG table - see OutboxLiquibaseAutoConfiguration,
      which registers this changelog as a second, independent SpringLiquibase bean. Postgres-only:
      JSONB columns and partial/expression indexes throughout.
    -->
    <include file="classpath:db/changelog/outbox/0001-create-outbox-message.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/outbox/0002-index-poll.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/outbox/0003-index-ordering-key.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/outbox/0004-unique-idempotency-key.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/outbox/0005-create-status-history.sql" relativeToChangelogFile="false"/>

</databaseChangeLog>
