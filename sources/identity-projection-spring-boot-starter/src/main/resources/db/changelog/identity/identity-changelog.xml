<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      Includes only. Every changeset is formatted SQL in its own NNNN-<slug>.sql file beside this
      one - see the database-migration capability. This file stays XML because Liquibase's
      formatted-SQL parser has no include directive; it is wiring, not a migration.

      Schema for identity-projection-spring-boot-starter. Changeset ids and author are namespaced
      ("identity-NNNN", "ludwig-identity") so they never collide with a consuming application's own
      changesets in the shared DATABASECHANGELOG table - see IdentityLiquibaseAutoConfiguration,
      which registers this changelog as a second, independent SpringLiquibase bean.
    -->
    <include file="classpath:db/changelog/identity/0001-create-security-user.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/identity/0002-create-security-user-role.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/identity/0003-create-security-partner.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/identity/0004-create-security-partner-role.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/identity/0005-create-security-grant.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/identity/0006-security-grant-dimension-check.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/identity/0007-security-user-contact.sql" relativeToChangelogFile="false"/>

</databaseChangeLog>
