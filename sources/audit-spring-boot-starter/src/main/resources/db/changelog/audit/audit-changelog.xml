<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      Includes only. Every changeset is formatted SQL in its own NNNN-<slug>.sql file beside this
      one - see the database-migration capability. This file stays XML because Liquibase's
      formatted-SQL parser has no include directive; it is wiring, not a migration.

      Schema for audit-spring-boot-starter. Changeset ids and author are namespaced ("audit-NNNN",
      "ludwig-audit") so they never collide with a consuming application's own changesets in the
      shared DATABASECHANGELOG table - see AuditLiquibaseAutoConfiguration, which registers this
      changelog as an independent SpringLiquibase bean. Postgres-only.
    -->
    <include file="classpath:db/changelog/audit/0001-create-audit-event.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/audit/0002-migrate-user-setting-audit.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/audit/0003-migrate-sync-audit-record.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/audit/0004-normalise-redaction-marker.sql" relativeToChangelogFile="false"/>

</databaseChangeLog>
