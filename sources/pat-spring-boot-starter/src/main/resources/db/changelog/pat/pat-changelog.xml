<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      Includes only. Every changeset is formatted SQL in its own NNNN-<slug>.sql file beside this
      one - see the database-migration capability. This file stays XML because Liquibase's
      formatted-SQL parser has no include directive; it is wiring, not a migration.

      Schema for pat-spring-boot-starter. Changeset ids and author are namespaced ("pat-NNNN",
      "ludwig-pat") so they never collide with a consuming application's own changesets in the
      shared DATABASECHANGELOG table - see PatLiquibaseAutoConfiguration, which registers this
      changelog as an independent SpringLiquibase bean, exactly as the idempotency and
      identity-projection modules do.

      One table. There is deliberately no shared "credential" table and no inheritance hierarchy
      waiting for a second credential type: a deploy key or a signed webhook secret would have a
      different lifecycle, a different issuance authority and a different revocation story, and a
      table built to hold all three would hold none of them well.
    -->
    <include file="classpath:db/changelog/pat/0001-create-token.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/pat/0002-unique-key-ids.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/pat/0003-owner-index.sql" relativeToChangelogFile="false"/>

</databaseChangeLog>
