<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      Includes only. Every changeset is formatted SQL in its own NNNN-<slug>.sql file beside this
      one - see the database-migration capability. This file stays XML because Liquibase's
      formatted-SQL parser has no include directive; it is wiring, not a migration.

      Schema for user-settings-spring-boot-starter. Changeset ids and author are namespaced
      ("user-settings-NNNN", "ludwig-user-settings") so they never collide with a consuming
      application's own changesets in the shared DATABASECHANGELOG table - see
      UserSettingsLiquibaseAutoConfiguration, which registers this changelog as a second,
      independent SpringLiquibase bean.

      The same three tables serve owner mode and projection mode. A projection is a replica, not a
      different shape, and giving it its own schema would mean two sets of migrations that have to
      be kept in step forever - and a bug fixed in one of them.
    -->
    <include file="classpath:db/changelog/user-settings/0001-create-user-setting-value.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/user-settings/0002-user-setting-value-scope-check.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/user-settings/0003-create-user-setting-audit.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/user-settings/0004-create-user-consent.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/user-settings/0005-user-consent-update-guard.sql" relativeToChangelogFile="false"/>

</databaseChangeLog>
