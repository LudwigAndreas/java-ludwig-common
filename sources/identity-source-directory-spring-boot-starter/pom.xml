<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ru.ludwigandreas</groupId>
        <artifactId>common</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>identity-source-directory-spring-boot-starter</artifactId>
    <packaging>jar</packaging>

    <name>Identity source: directory</name>
    <description>
        Feeds identity-projection-spring-boot-starter from providers that expose their users over an API. A service
        implements one interface, IdentityDirectory, against its provider; the starter syncs changes incrementally
        from a persisted watermark, sweeps each source completely on a schedule, runs both as job-core jobs under run
        locks, and isolates failures per source.
    </description>

    <!-- Third-party versions come from ludwig-bom, imported rather than inherited; see identity-projection's POM. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>ludwig-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The projection this feeds, through its IdentityProjection SPI. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>identity-projection-spring-boot-starter</artifactId>
        </dependency>
        <!-- Scheduling (ScheduledJob) and single-replica execution (RunLock); the jobs area lists and runs both jobs. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>job-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Optional: ludwig_identity_directory_run_seconds, registered only where a MeterRegistry exists. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Optional: the state table shipped as a Liquibase changelog, applied only if the consumer uses Liquibase. -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- The constraint annotations on IdentityDirectoryProperties; the API only and optional, as messaging's. -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>test-support</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- A Bean Validation provider, so the @Validated properties in a full test context are checked. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The security starter's auto-configuration cannot be introspected without web-core on the classpath. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>web-core-spring-boot-starter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>architecture-rules</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
