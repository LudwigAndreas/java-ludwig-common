<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      Includes only. Every changeset is formatted SQL in its own NNNN-<slug>.sql file beside this
      one - see the database-migration capability. This file stays XML because Liquibase's
      formatted-SQL parser has no include directive; it is wiring, not a migration.

      Schema for file-action-spring-boot-starter. Changeset ids and author are namespaced
      ("file-action-NNNN", "ludwig-file-action") so they never collide with a consuming
      application's own changesets in the shared DATABASECHANGELOG table - see
      FileActionLiquibaseAutoConfiguration, which registers this changelog as an independent
      SpringLiquibase bean.

      Two tables, and deliberately not three. There is no shared operation table - the
      long-running-operations capability forbids one and gives the reasons - so this module keeps
      its own submission row and maps it onto the envelope at its edge. And the rejects are a
      BOUNDED sample rather than the full set: a hundred thousand rejects from one bad upload would
      be a hundred thousand rows, and the full set already exists as an artifact in the object
      store, which is where something that large belongs.
    -->
    <include file="classpath:db/changelog/file-action/0001-create-submission.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/file-action/0002-create-row-reject.sql" relativeToChangelogFile="false"/>

</databaseChangeLog>
