<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      Includes only, as every root changelog in this repository is - see the database-migration
      capability. The path is named by spring.liquibase.change-log in
      src/test/resources/application.properties and so is deliberately unchanged.

      The test application's own table. The module's tables come from its shipped changelog, applied
      as a second, independent SpringLiquibase bean - which is exactly the arrangement a consuming
      service has, so the tests exercise it rather than a simplification of it.

      The changeset is namespaced "reconciliation-test-NNNN" with author
      "ludwig-reconciliation-test", so it cannot be mistaken for one of the module's own.
    -->
    <include file="classpath:db/changelog/test/0001-create-local-order.sql" relativeToChangelogFile="false"/>

</databaseChangeLog>
