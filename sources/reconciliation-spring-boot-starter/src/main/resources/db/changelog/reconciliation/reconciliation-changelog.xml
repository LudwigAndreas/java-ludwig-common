<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      Includes only. Every changeset is formatted SQL in its own NNNN-<slug>.sql file beside this
      one - see the database-migration capability. This file stays XML because Liquibase's
      formatted-SQL parser has no include directive; it is wiring, not a migration.

      Schema for reconciliation-spring-boot-starter. Changeset ids and author are namespaced
      ("reconciliation-NNNN", "ludwig-reconciliation") so they never collide with a consuming
      application's own changesets in the shared DATABASECHANGELOG table - see
      ReconciliationLiquibaseAutoConfiguration, which registers this changelog as an independent
      SpringLiquibase bean. Postgres-only: JSONB columns and partial indexes throughout.
    -->
    <include file="classpath:db/changelog/reconciliation/0001-create-inbox-record.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/reconciliation/0002-index-inbox-claim.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/reconciliation/0003-index-inbox-key-history.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/reconciliation/0004-index-inbox-stale-and-ops.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/reconciliation/0005-index-inbox-fetch-suppression.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/reconciliation/0006-create-task-state.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/reconciliation/0007-create-remote-job.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/reconciliation/0008-index-remote-job.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/reconciliation/0009-create-quota-lease.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/reconciliation/0010-create-quota-waiter.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/reconciliation/0011-create-audit-record.sql" relativeToChangelogFile="false"/>

</databaseChangeLog>
