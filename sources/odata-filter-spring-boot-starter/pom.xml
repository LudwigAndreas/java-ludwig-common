<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ru.ludwigandreas</groupId>
        <artifactId>common</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>odata-filter-spring-boot-starter</artifactId>
    <packaging>jar</packaging>

    <name>OData filter Spring Boot starter</name>
    <description>
        Enterprise-ready OData $filter/$top/$skip/$orderby support for Spring Boot + Spring Data JPA
        REST APIs: parses OData query options into type-safe QueryDSL predicates, with configurable
        nesting-depth limits, max page size, role-based field access control and pluggable validation.
    </description>

    <!--
        The JDK baseline and the spring-boot-dependencies import are inherited from the parent pom,
        ru.ludwigandreas:common. Third-party versions are NOT: they moved to ludwig-bom, imported
        below, so that a downstream service can get exactly the same set by importing one artifact
        instead of copying a properties block it cannot see.

        ludwig-bom is imported rather than inherited on purpose. Keeping ru.ludwigandreas:common as
        the parent is what keeps this module usable by a service running a DIFFERENT Spring Boot
        line - a library built against a fixed spring-boot-starter-parent bakes that line into
        itself. For the same reason this module does not inherit ludwig-service-parent; see the
        note in that file.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>ludwig-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot autoconfiguration machinery -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Pageable/Sort only - no JPA/Hibernate coupling required -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>

        <!-- Type-safe predicate construction -->
        <dependency>
            <groupId>com.querydsl</groupId>
            <artifactId>querydsl-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.querydsl</groupId>
            <artifactId>querydsl-jpa</artifactId>
            <classifier>jakarta</classifier>
        </dependency>

        <!-- Entity metadata (associations, collections) used for safe nested-path resolution -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!-- Official OData ABNF tokenizer for $filter/$orderby grammar -->
        <dependency>
            <groupId>org.apache.olingo</groupId>
            <artifactId>odata-server-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.olingo</groupId>
            <artifactId>odata-server-core</artifactId>
        </dependency>

        <!-- Optional: Spring MVC integration (argument resolver + ProblemDetail advice) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Optional: the shared localized problem pipeline. When present, this module contributes a
            mapper and a message bundle to it instead of registering its own exception advice - see
            ODataFilterWebAutoConfiguration. Optional so that a service which does not use the
            web-core starter keeps working, on the legacy advice, with no change.
        -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>web-core-spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Optional: applied/rejected-filter counts and parse-duration metrics -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- The platform's one audit sink. Not optional: "who queried what" is this module's own
             trail, and a trail that is present only when a consumer remembered a dependency is a
             trail an auditor cannot rely on. audit-core has zero in-repo dependencies, which is what
             makes it safe for any module to take. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>audit-core</artifactId>
        </dependency>

        <!-- Optional: describes the ODataQueryOptions parameter in the application's OpenAPI document.
             Without it the five query options vanish from the document, which is one of the four
             objections that made the deleted ODataQueryArgumentResolver unusable - inheriting it would
             have been the same defect in a new place. The -common artifact, not -webmvc-ui: this module
             contributes a customizer and has no business adding swagger-ui to a service. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-common</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Optional: validates this starter's own bound properties at startup. The constraints on
             ODataFilterProperties are real - a max-page-size of 0 was accepted until this was added, and
             made every query fail at the first request instead of failing the context.

             It is an IMPLEMENTATION and not just jakarta.validation-api, and that distinction is the whole
             history of this dependency. swagger-core drags the API in transitively, and the API alone on
             the classpath activates Spring Boot's and web-core's validation wiring, which then needs an
             implementation - which this module did not have, so every one of its integration tests failed
             with NoClassDefFoundError on hibernate-validator's ResourceBundleLocator. That was fixed by
             excluding the API from springdoc; now the API arrives deliberately, with something able to run
             it, and the exclusion is gone because it would contradict this.

             Optional, so it does not reach a consumer. Every in-repo consumer already ships one through
             spring-boot-starter-validation. -->
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Optional: role resolution from the security context, only if the app uses Spring Security -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Consumers supply their own driver; only used on this module's test classpath -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            The platform's container images, singleton containers and fixtures. One test-scoped
            dependency; the digests live in its images.properties, not here.
        -->
        <!-- The shared ArchUnit rule library, applied to this module by its own ArchitectureTest. It had
             none until the audit rule below needed one: a rule nothing runs is prose, and the AUDIT group
             had therefore never been applied to the very module it was written for. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>architecture-rules</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>test-support</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
