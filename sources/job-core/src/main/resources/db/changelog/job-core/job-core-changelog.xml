<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
      Includes only. Every changeset is formatted SQL in its own NNNN-<slug>.sql file beside this
      one - see the database-migration capability. This file stays XML because Liquibase's
      formatted-SQL parser has no include directive; it is wiring, not a migration.

      Applied by JobCoreLiquibaseAutoConfiguration as an independent SpringLiquibase bean, or
      included from a consuming application's own master changelog with
      ludwig.job-core.liquibase.enabled=false. Postgres-only.
    -->
    <include file="classpath:db/changelog/job-core/0001-create-run-lock.sql" relativeToChangelogFile="false"/>

</databaseChangeLog>
