<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ru.ludwigandreas</groupId>
        <artifactId>common</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>crud-service-example</artifactId>
    <packaging>jar</packaging>

    <name>Product catalog CRUD example service</name>
    <description>
        Reference CRUD microservice built on this repository's own modules (db-core, odata-filter,
        outbox): three model layers (web DTO / service domain / JPA entity) wired by MapStruct,
        Lombok instead of hand-written boilerplate, exclusively compile-time-checked QueryDSL-JPA
        queries (no JDBC, no derived-query or JPQL strings resolved at runtime), and fully localized
        (i18n) validation and RFC 7807 error responses.
    </description>

    <!-- Java version, third-party dependency versions and the spring-boot-dependencies BOM import
         are all centralized in the parent pom - see its <properties>/<dependencyManagement>. -->

    <dependencies>
        <!-- This repository's own modules: base entities/repositories, OData query parsing,
             transactional outbox. db-core transitively brings spring-boot-starter-data-jpa,
             querydsl-jpa and the Postgres driver. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>db-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>odata-filter-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>outbox-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Authentication (edge-minted JWT + partner mTLS) and both levels of authorization. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>security-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Roles and grants from the local projection of the OIDC user stream, rather than from claims. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>identity-projection-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Backs the security module's authority cache; without it every request re-resolves roles. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Bean Validation: request DTO constraints, with messages resolved from i18n bundles. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Metrics exposed by db-core/odata-filter/outbox are all Micrometer-based. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Schema migrations, including the outbox module's shipped changelog. -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>

        <!-- The outbox module declares spring-kafka optional; the default route here is Kafka. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <version>${spring-kafka.version}</version>
        </dependency>

        <!-- Compile-time generated mappers between the three model layers. -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Keeps method parameter names in the bytecode, so @PathVariable/@RequestParam
                         need no explicit name. spring-boot-starter-parent sets this for you; this
                         project has its own parent, so it is set here. -->
                    <parameters>true</parameters>
                    <!--
                        Three annotation processors, one compilation:
                          - Lombok generates the entity accessors/constructors,
                          - QueryDSL's JPAAnnotationProcessor generates the Q-types every query in
                            this service is written against (that is what makes the queries
                            compile-time checked),
                          - MapStruct generates the layer-to-layer mappers.
                        lombok-mapstruct-binding is what makes MapStruct see Lombok-generated
                        accessors; without it MapStruct runs before Lombok and maps nothing.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>com.querydsl</groupId>
                            <artifactId>querydsl-apt</artifactId>
                            <classifier>jakarta</classifier>
                            <version>${querydsl.version}</version>
                        </path>
                        <path>
                            <groupId>jakarta.persistence</groupId>
                            <artifactId>jakarta.persistence-api</artifactId>
                            <version>3.1.0</version>
                        </path>
                    </annotationProcessorPaths>
                    <annotationProcessors>
                        <annotationProcessor>lombok.launch.AnnotationProcessorHider$AnnotationProcessor</annotationProcessor>
                        <annotationProcessor>com.querydsl.apt.jpa.JPAAnnotationProcessor</annotationProcessor>
                        <annotationProcessor>org.mapstruct.ap.MappingProcessor</annotationProcessor>
                    </annotationProcessors>
                    <compilerArgs>
                        <!-- Unmapped target properties and unknown @Mapping targets fail the build
                             instead of silently producing a half-filled object. -->
                        <compilerArg>-Amapstruct.unmappedTargetPolicy=ERROR</compilerArg>
                        <compilerArg>-Amapstruct.defaultComponentModel=spring</compilerArg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
