<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!--
        Includes only. Every changeset is formatted SQL in its own NNNN-<slug>.sql file under
        changes/ - see the database-migration capability. This file stays XML because Liquibase's
        formatted-SQL parser has no include directive; it is wiring, not a migration.
    -->

    <!-- This service's own schema. -->
    <include file="classpath:db/changelog/changes/0001-request.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/changes/0002-delivery.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/changes/0003-delivery-indexes.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/changes/0004-delivery-status-history.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/changes/0005-delivery-content.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/changes/0006-recipient-profile.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/changes/0007-recipient-preference.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/changes/0008-suppression.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/changes/0009-idempotency.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/changes/0010-lock.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/changes/0011-rate-limit-window.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/changes/0012-template-revision.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/changes/0013-record-quiet-hours-deferral.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/changes/0014-drop-recipient-preference.sql" relativeToChangelogFile="false"/>
    <include file="classpath:db/changelog/changes/0015-drop-recipient-profile.sql" relativeToChangelogFile="false"/>

    <!--
        The outbox module ships its own changelog inside its jar. Including it here - rather than
        letting the module apply it standalone, see ludwig.outbox.liquibase.enabled=false - keeps
        every table this service owns under one migration history. Its changeset ids are namespaced
        (outbox-NNNN/ludwig-outbox), so they cannot collide with the ones above.
    -->
    <include file="classpath:db/changelog/outbox/outbox-changelog.xml" relativeToChangelogFile="false"/>

    <!--
        Same arrangement for job-core's job_run_lock, which replaced this service's own
        notification_lock - see ludwig.job-core.liquibase.enabled=false. Its changeset ids are
        namespaced (job-core-NNNN/ludwig-job-core).

        This include sits ABOVE 0016-drop-lock-table.sql, and the order is not cosmetic: an <include>
        contributes its changesets at the position it appears, so putting it after the drop would
        leave a fresh database with neither lock table between the two changesets - and a deployment
        that failed part way through the migration would come up with no lock at all.
    -->
    <include file="classpath:db/changelog/job-core/job-core-changelog.xml" relativeToChangelogFile="false"/>

    <include file="classpath:db/changelog/changes/0016-drop-lock-table.sql" relativeToChangelogFile="false"/>

    <!--
        Same arrangement for idempotency-spring-boot-starter's idempotency_claim, which replaced this
        service's own notification_idempotency - see ludwig.idempotency.liquibase.enabled=false. Its
        changeset ids are namespaced (idempotency-NNNN/ludwig-idempotency).

        This include sits ABOVE 0017-drop-idempotency.sql, and the order is load-bearing for a
        stronger reason than it was for the lock: the module's changelog carries the changeset that
        MOVES every row out of the old table, and an <include> contributes its changesets at the
        position it appears. Putting it after the drop would discard every in-flight key - and every
        in-flight key is a claim on work that has been done, so every one of them is a notification
        this service would send to a real person a second time.
    -->
    <include file="classpath:db/changelog/idempotency/idempotency-changelog.xml" relativeToChangelogFile="false"/>

    <include file="classpath:db/changelog/changes/0017-drop-idempotency.sql" relativeToChangelogFile="false"/>

    <!--
        Same arrangement for the identity projection's tables (security_user, security_partner,
        security_grant and their role tables) - see ludwig.identity.liquibase.enabled=false. This
        service sets ludwig.identity.contact.enabled, so its security_user rows carry the verified
        contact data recipient resolution reads.
    -->
    <include file="classpath:db/changelog/identity/identity-changelog.xml" relativeToChangelogFile="false"/>

    <!--
        The settings replica (user_setting_value, user_setting_audit, user_consent) is deliberately
        NOT included here, unlike the two above, and the difference is that this dependency is
        optional.

        An <include> is resolved when the master changelog is parsed, so naming a file that ships
        inside a jar this deployment does not have would fail every migration - and therefore every
        startup - rather than degrade. Since the module can apply its own changelog as a second
        SpringLiquibase whenever a mode is enabled, and does so by default
        (ludwig.user-settings.liquibase.enabled), the schema arrives exactly when the module does and
        this file stays valid whether or not it is deployed.

        That is a real trade: the three tables land in their own DATABASECHANGELOG history rather
        than this service's single one. Worth it, because the alternative couples the ability to
        migrate to the presence of an optional jar.
    -->
</databaseChangeLog>
