<?xml version="1.0" encoding="UTF-8"?>
<!--
    Fixture for scripts/check_build_metadata.sh - -self-test: every rule stays quiet on this file.

    Not named pom.xml on purpose, so that nothing which sweeps the tree for POMs mistakes a fixture
    for a module. One setting is deliberately under pluginManagement rather than on the declared
    plugin, because the checker reads both and that path needs a fixture too.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>fixture</groupId>
    <artifactId>conforming</artifactId>
    <version>1</version>
    <packaging>pom</packaging>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>io.github.git-commit-id</groupId>
                    <artifactId>git-commit-id-maven-plugin</artifactId>
                    <configuration>
                        <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <configuration>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
                    <includeOnlyProperties>
                        <includeOnlyProperty>^git\.commit\.(id|time)$</includeOnlyProperty>
                        <includeOnlyProperty>^git\.commit\.id\.abbrev$</includeOnlyProperty>
                        <includeOnlyProperty>^git\.(branch|dirty)$</includeOnlyProperty>
                    </includeOnlyProperties>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prune-empty-git-properties</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete quiet="true">
                                    <fileset dir="${project.build.outputDirectory}" erroronmissingdir="false">
                                        <include name="git.properties"/>
                                        <not>
                                            <contains text="git.commit.id="/>
                                        </not>
                                    </fileset>
                                </delete>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
