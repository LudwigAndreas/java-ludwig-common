<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!--
        THE PARENT OF A SERVICE IS ludwig-service-parent, never the reactor root.

        A service outside this repository writes this block as:

            <parent>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>ludwig-service-parent</artifactId>
                <version>1.1.0</version>
                <relativePath/>
            </parent>

        - a literal version, and an EMPTY <relativePath/>. The empty element is not decoration:
        omitted, Maven looks for ../pom.xml, and in a service checked out on its own there is no
        such file (or worse, there is an unrelated one), so the build fails with a confusing
        "non-resolvable parent". See README, "Consuming the platform", which is the snippet to copy.

        This module, living inside the platform's own reactor, must do it the other way round, and
        the reason is a hard Maven rule rather than a preference: ${revision} is only substituted in
        a <parent> block when Maven can read the parent POM from disk. With an empty <relativePath/>
        it resolves the parent from the repository instead, and searches for an artifact whose
        version is the literal seven characters "${revision}", which cannot exist. So a module that
        wants the repository's single ci-friendly version has to point at the file, and a module that
        wants the standalone shape has to repeat a literal version. Inside this reactor the first is
        correct - one version, declared once, in .mvn/maven.config.
    -->
    <parent>
        <groupId>ru.ludwigandreas</groupId>
        <artifactId>ludwig-service-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../ludwig-service-parent/pom.xml</relativePath>
    </parent>

    <artifactId>notification-service</artifactId>
    <packaging>jar</packaging>

    <name>Notification service</name>
    <description>
        The platform's single notification service: every other service asks this one to notify
        somebody instead of talking to a mail server itself. Kafka and REST ingress converge on one
        application service, requests fan out into per-recipient-per-channel deliveries held in a
        Postgres work queue, and a poller renders a FreeMarker template and dispatches it through an
        SPI channel (SMTP, internal chat, signed webhook), recording every transition.
    </description>

    <!--
        NO VERSIONS BELOW - not on the platform's own modules, not on the third-party libraries, not
        on a plugin. All of them come from ludwig-bom, which ludwig-service-parent imports. The
        compiler, its four annotation processors, surefire, failsafe, jacoco, the enforcer and jib
        are all configured in that parent too, which is why this file no longer has a <build>
        section describing them.
    -->

    <properties>
        <!--
            The gate inherited from ludwig-service-parent is 0.70 instruction / 0.60 branch. This
            service lowers it rather than switching it off, so the number it actually holds stays
            visible and can be ratcheted up. The figures reflect the unit tests alone: the
            lifecycle and Kafka-ingress integration tests are failsafe tests and need a Docker
            daemon, and the merged number is substantially higher where one is available.
        -->
        <jacoco.instruction.coverage.minimum>0.14</jacoco.instruction.coverage.minimum>
        <jacoco.branch.coverage.minimum>0.20</jacoco.branch.coverage.minimum>
    </properties>

    <dependencies>
        <!-- Base entities, BaseRepository/BaseRepositoryImpl, Predicates, PageableUtils. Brings
             spring-boot-starter-data-jpa, querydsl-jpa and the Postgres driver transitively. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>db-core</artifactId>
        </dependency>
        <!-- The admin/history search endpoint's $filter/$orderby/$top/$skip. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>odata-filter-spring-boot-starter</artifactId>
        </dependency>
        <!-- OUTBOUND LIFECYCLE EVENTS ONLY - never the delivery queue. See README section
             "The delivery queue is not the outbox". -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>outbox-spring-boot-starter</artifactId>
        </dependency>
        <!-- All error handling: LocalizedException, ExceptionProblemMapper, PageResponse. This
             service ships no @RestControllerAdvice of its own. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>web-core-spring-boot-starter</artifactId>
        </dependency>
        <!-- Authn/authz on the REST API, plus DataScope tenant isolation of delivery history. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>security-spring-boot-starter</artifactId>
        </dependency>
        <!-- Existence, display name, tenant and active-status of a recipient given a user id. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>identity-projection-spring-boot-starter</artifactId>
        </dependency>
        <!-- FreeMarker template hot reload, Vault-backed SMTP credentials, and the runtime
             channel-enable/rate-limit view (RefreshableConfig). -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>hot-reload-spring-boot-starter</artifactId>
        </dependency>
        <!-- Tracing, JSON logging with masking, correlation id across HTTP and Kafka, split probes,
             graceful shutdown. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>observability-spring-boot-starter</artifactId>
        </dependency>
        <!-- RetryingCall/RetryPolicy for the in-attempt retry inside a single channel send. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>common-utils</artifactId>
        </dependency>

        <!-- Backs the security module's authority cache. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- The SMTP channel. JavaMailSender, multipart MIME, and the transport itself. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- hot-reload declares freemarker optional; template rendering is this service's core. -->
        <dependency>
            <groupId>org.freemarker</groupId>
            <artifactId>freemarker</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Schema migrations, including the outbox and identity changelogs shipped in their jars. -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>
        <!-- Primary ingress, and the transport the outbox dispatches lifecycle events over. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!-- OpenAPI, sharing the ProblemDetail schema web-core already produces. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>architecture-rules</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Waiting for a broker to deliver a record is inherently asynchronous; Awaitility makes the
             wait an explicit, bounded condition instead of a sleep chosen by guesswork. -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- A real SMTP server in-process, so the email channel is tested against SMTP rather than
             against a mock of JavaMailSender. -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!--
                The one opt-in. Checkstyle is configured in ludwig-service-parent but not activated
                there - activating it would make that pom-packaging file resolve the checkstyle-rules
                artifact it has no sources to check with. No version, no configuration: inherited.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
            <!--
                This module uses the repository's ci-friendly ${revision} in its <parent> block, so
                its installed POM has to have that resolved into a literal - an unflattened POM
                saying "${revision}" is not resolvable by anyone. Version, configuration and
                executions all come from ludwig-service-parent's pluginManagement.

                A service with a literal version of its own does not need this.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
