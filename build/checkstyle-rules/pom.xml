<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ru.ludwigandreas</groupId>
        <artifactId>common</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>checkstyle-rules</artifactId>
    <packaging>jar</packaging>

    <name>Code style rules (Checkstyle)</name>
    <description>
        The shared Checkstyle configuration - formatting that mirrors IntelliJ IDEA's defaults,
        naming, source-level conventions and Javadoc - packaged as a jar so a downstream service
        consumes it as a maven-checkstyle-plugin dependency instead of copying the XML.
    </description>

    <!--
        Resources only in main: no Java there, and no compile-scope dependency. A build-tooling
        artifact must not be able to drag anything onto a consumer's classpath, and the
        maven-checkstyle-plugin only ever reads these two files off its own plugin classpath. The
        two dependencies below are test-scoped and therefore reach nobody: they exist so the
        configuration can be executed against fixture sources and asserted on, which is the only
        way a rule in an XML file can have a test at all.

        This repository does NOT consume the jar - the root pom points the plugin straight at
        src/main/resources below. That is deliberate: Maven resolves plugin dependencies from
        the local repository and not from the reactor, so a jar-based reference would make a
        clean clone fail until someone had installed this module first. A downstream service,
        where the artifact is already published, uses the jar. See README.md.
    -->

    <!--
        Imported like every other library module in the reactor, so that a test dependency added
        here later resolves against the platform's version registry rather than against whatever
        spring-boot-dependencies happens to carry. The root POM cannot import it - it is the BOM's
        parent, and that would be circular.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>ludwig-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            The engine the rules are executed on in the test below. The version is
            ${checkstyle.version} from the reactor root - the SAME number the
            maven-checkstyle-plugin's own <dependencies> override uses - on purpose: a test that
            asserted the configuration's behaviour on a different engine from the one the build
            runs would assert nothing about the build.
        -->
        <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Version from the imported spring-boot-dependencies; see the root POM on why JUnit is
             deliberately unpinned. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                src/main is resources only, so there is nothing there to check; the test sources
                added for CheckstyleConfigurationTest are ordinary Java and are checked like
                everything else. The deliberately non-compliant FIXTURES are not: they live under
                src/test/resources, which the plugin's sourceDirectories do not include, which is
                exactly why they are resources rather than test sources.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
