<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ru.ludwigandreas</groupId>
        <artifactId>common</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>job-core</artifactId>
    <packaging>jar</packaging>

    <name>Ludwig job core</name>
    <description>
        The mechanics every scheduled, database-backed worker in this platform is built from, in one
        place so that there is one of each rather than one per module: exponential backoff with jitter
        and a cap, a SmartLifecycle scheduling base that owns its own TaskScheduler and drains on
        shutdown instead of abandoning claimed rows, the FOR UPDATE SKIP LOCKED claim statement, a
        stable instance identity for lock-owner columns, and a leased run lock that survives the death
        of the process holding it. Consumed by outbox-spring-boot-starter and
        reconciliation-spring-boot-starter.
    </description>

    <!--
        Same arrangement as every other library module here: the JDK baseline and the
        spring-boot-dependencies import come from the parent, third-party versions come from
        ludwig-bom imported below, and the parent is deliberately NOT ludwig-service-parent - a
        library that inherits spring-boot-starter-parent bakes one Boot line into itself and stops
        being usable by a service running a different one.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>ludwig-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- SmartLifecycle, TaskScheduler, CronTrigger -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- Spring Boot autoconfiguration machinery for the RunLock bean -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            EntityManager, for the JPA-flavoured overload of the claim helper. Compile-scope API only:
            this module maps no entities of its own and imposes no entity scanning on a consumer.
        -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!-- Interval arithmetic for the backoff calculator only - see BackoffCalculator. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!--
            Optional: only MicrometerRunLockListener touches it, and that class is loaded only behind
            @ConditionalOnClass in JobCoreAutoConfiguration. A library must not drag an observability
            stack into an application that did not ask for one, so a consumer without Micrometer gets
            the no-op listener and is otherwise unaffected. The version comes from
            spring-boot-dependencies via the reactor root - deliberately NOT pinned in ludwig-bom,
            which would fork Micrometer from the Boot line that manages it.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Optional: the shipped changelog is only applied if the consumer uses Liquibase. -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            A real PostgreSQL for JdbcRunLockIT. The lock's correctness is entirely in how Postgres
            behaves when two transactions meet on a row - ON CONFLICT, FOR UPDATE SKIP LOCKED and
            RETURNING - so an in-memory database would pass the suite and prove nothing.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>

            <!--
                Failsafe, which the library modules in this repository do not normally have: they run
                their container-backed tests under surefire by naming them *IntegrationTest, because
                surefire's default includes pick that up and nothing here excludes it.

                This module needs the real split. JdbcRunLockIT starts a container and contends on it
                from several threads, which is not something `mvn test` should do on every build of
                every module that depends on job-core - and since the lock is now the platform's only
                one, the suite has to exist and has to run somewhere. Binding failsafe here puts it at
                `verify`, the same phase and the same name convention the services use, so there is
                one rule to remember rather than two.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <id>integration-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
