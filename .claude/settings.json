{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__code-index__set_project_path",
      "mcp__code-index__build_deep_index",
      "mcp__code-index__refresh_index",
      "mcp__code-index__refresh_search_tools",
      "mcp__code-index__find_files",
      "mcp__code-index__search_code_advanced",
      "mcp__code-index__get_file_summary",
      "mcp__code-index__get_symbol_body",
      "mcp__code-index__get_file_watcher_status",
      "mcp__code-index__get_settings_info",
      "mcp__code-index__check_temp_directory",

      "Bash(openspec list *)",
      "Bash(openspec show *)",
      "Bash(openspec status *)",
      "Bash(openspec validate *)",
      "Bash(openspec context *)",
      "Bash(openspec doctor *)",
      "Bash(openspec instructions *)",
      "Bash(openspec templates *)",
      "Bash(openspec new change *)",
      "Bash(openspec spec *)",
      "Bash(openspec change *)",

      "Bash(scripts/manifest.sh *)",
      "Bash(./scripts/manifest.sh *)",
      "Bash(scripts/gate.sh *)",
      "Bash(./scripts/gate.sh *)",

      "Bash(mvn -q validate)",
      "Bash(mvn validate)",
      "Bash(mvn -pl * -am verify)",
      "Bash(mvn -pl * -am test)",
      "Bash(mvn -pl * -am install)",
      "Bash(mvn -pl * test)",
      "Bash(mvn -pl * verify)",
      "Bash(mvn clean install)",
      "Bash(mvn dependency:tree *)",
      "Bash(mvn -pl * dependency:tree *)",
      "Bash(mvn help:effective-pom *)",
      "Bash(mvn -pl * help:effective-pom *)",
      "Bash(mvn javadoc:javadoc)",

      "Bash(rg *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(mvn deploy*)",
      "Bash(mvn * deploy*)",
      "Bash(mvn *-Pci*)",
      "Bash(mvn *jib:build*)",
      "Bash(mvn *-Dcheckstyle.skip*)",
      "Bash(mvn *-Djacoco.skip*)",
      "Bash(mvn *-Denforcer.skip*)",

      "mcp__code-index__clear_settings",

      "Edit(**/target/**)",
      "Write(**/target/**)",
      "Edit(**/generated-sources/**)",
      "Write(**/generated-sources/**)",
      "Edit(**/.flattened-pom.xml)",
      "Write(**/.flattened-pom.xml)",
      "Edit(openspec/changes/archive/**)",
      "Write(openspec/changes/archive/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 15,
            "statusMessage": "Checking index and manifest freshness..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edit.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pom-changed.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
