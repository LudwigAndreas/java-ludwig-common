<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ru.ludwigandreas</groupId>
        <artifactId>common</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>user-settings-spring-boot-starter</artifactId>
    <packaging>jar</packaging>

    <name>User settings Spring Boot starter</name>
    <description>
        The platform's engine for per-user settings, preferences and consents - the data an OIDC provider
        does not own. Setting schemas are typed, compile-time artifacts declared by the consuming service;
        this module owns storage, layered resolution (user, role, tenant, platform, definition default),
        caching, validation, auditing and consent history. Runs in owner mode (owns the tables, serves
        writes, publishes change events through the transactional outbox) or in projection mode (consumes
        those events into a local read-only replica), and both expose the same SettingsLookup so a
        consuming service is written once and does not know which mode it runs in.
    </description>

    <!--
        The JDK baseline and the spring-boot-dependencies import are inherited from the parent pom,
        ru.ludwigandreas:common. Third-party versions are NOT: they come from ludwig-bom, imported
        below, so that a downstream service can get exactly the same set by importing one artifact
        instead of copying a properties block it cannot see.

        ludwig-bom is imported rather than inherited on purpose. Keeping ru.ludwigandreas:common as
        the parent is what keeps this module usable by a service running a DIFFERENT Spring Boot
        line - a library built against a fixed spring-boot-starter-parent bakes that line into
        itself. For the same reason this module does not inherit ludwig-service-parent; see the
        note in that file.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ru.ludwigandreas</groupId>
                <artifactId>ludwig-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            The audit STARTER, not just audit-core: this module's trail was the one that was already
            persistent (user_setting_audit), so it needs the audit_event table, its Liquibase changelog and
            the migration of its own rows into it. This module sits above db-core, so taking the starter is
            not the problem it would be for security, rest-client or hot-reload.
        -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>audit-spring-boot-starter</artifactId>
        </dependency>

        <!--
            PrincipalRef is the lookup key of this module's whole API, LudwigPrincipal is what the
            self-or-admin check reads, and the cache is modelled directly on AuthorityCache.
        -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>security-spring-boot-starter</artifactId>
        </dependency>
        <!-- db-core: AuditedEntity/SnapshotEntity/BaseRepository and the auditing infrastructure. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>db-core</artifactId>
        </dependency>
        <!--
            NOT optional, unlike in security-spring-boot-starter. There the web-core dependency buys
            only an extra problem mapper, so a service without the REST stack can do without it. Here
            every failure this module raises - an unknown setting, a value that fails its definition's
            validation, a write to a setting that is not user-editable - IS a LocalizedException, so
            the type is on the module's own throw paths and a consumer that lacked it would get a
            NoClassDefFoundError the first time a caller sent a bad value.
        -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>web-core-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Every dynamic query in this module is QueryDSL against generated Q-types. -->
        <dependency>
            <groupId>com.querydsl</groupId>
            <artifactId>querydsl-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.querydsl</groupId>
            <artifactId>querydsl-jpa</artifactId>
            <classifier>jakarta</classifier>
        </dependency>

        <!-- Compile-time generated mapping between entities and the service-facing models. -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!--
            A setting value is persisted opaquely as text plus a type discriminator; a structured
            value (a list, a record) is serialized to JSON into that same column. Nothing joins or
            reports on these values - see the README - so JSON here is a payload format, not a schema.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!--
            Optional: the settings cache. Without Caffeine on the classpath the module falls back to
            NoopSettingsCache and every lookup re-resolves - correct, just slower. Unlike the authority
            cache, that is purely a performance trade; see SettingsCache's Javadoc.
        -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Optional: owner mode publishes its change events through the transactional outbox. A
             projection-mode consumer never writes and therefore never needs it. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>outbox-spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Optional: the audit trail records the request's correlation id when one is bound. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>observability-spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Optional: admin search over settings and consent history, PII-flagged fields excluded. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>odata-filter-spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Optional: tenant and platform default layers reloadable without a redeploy. -->
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>hot-reload-spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Optional: the constraints on *Properties. Present as annotations only - a deployment
            without a Bean Validation implementation simply does not check them, and the module works
            exactly as before. Making it required would drag an implementation into every consumer
            for the sake of validating configuration the consumer may not even set.
        -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Optional: cache hit/miss, resolution latency and write counters. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Optional: projection mode consumes the owner's change stream. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Optional: the shipped REST controllers, which are off by default. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Optional: schema shipped as a Liquibase changelog, applied only if the consumer uses Liquibase. -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ru.ludwigandreas</groupId>
            <artifactId>architecture-rules</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- web-core wires Bean Validation to the shared MessageSource, so its autoconfiguration
             needs an implementation present once a full context is started. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Waiting for a broker to deliver a record is inherently asynchronous; Awaitility makes the
             wait an explicit, bounded condition instead of a sleep chosen by guesswork. -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- An in-memory database for the startup-validation tests, which assert that a broken
             definition stops the CONTEXT. They need a real context and no schema, so a container
             would cost seconds per case to prove something that never reaches the database. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        ORDER IS LOAD-BEARING. Lombok generates the accessors, QueryDSL's
                        JPAAnnotationProcessor generates the Q-types every query is written against,
                        MapStruct generates the entity-to-model mappers - and lombok-mapstruct-binding
                        must sit between Lombok and mapstruct-processor or MapStruct runs first and
                        maps nothing.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                        </path>
                        <path>
                            <groupId>com.querydsl</groupId>
                            <artifactId>querydsl-apt</artifactId>
                            <classifier>jakarta</classifier>
                        </path>
                        <path>
                            <groupId>jakarta.persistence</groupId>
                            <artifactId>jakarta.persistence-api</artifactId>
                        </path>
                    </annotationProcessorPaths>
                    <annotationProcessors>
                        <annotationProcessor>lombok.launch.AnnotationProcessorHider$AnnotationProcessor</annotationProcessor>
                        <annotationProcessor>com.querydsl.apt.jpa.JPAAnnotationProcessor</annotationProcessor>
                        <annotationProcessor>org.mapstruct.ap.MappingProcessor</annotationProcessor>
                    </annotationProcessors>
                    <compilerArgs>
                        <compilerArg>-Amapstruct.unmappedTargetPolicy=ERROR</compilerArg>
                        <compilerArg>-Amapstruct.defaultComponentModel=spring</compilerArg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
